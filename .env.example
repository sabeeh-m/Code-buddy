NODE_ENV=development
PORT=3000
REDIS_HOST=localhost
REDIS_PORT=6379
# Comma-separated list of allowed origins. Omit to leave CORS disabled.
# CORS_ORIGIN=https://example.com,https://app.example.com
# Global rate limit: THROTTLE_LIMIT requests per THROTTLE_TTL_MS per client.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
